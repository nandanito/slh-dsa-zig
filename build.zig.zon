.{
    .name = .slh_dsa,
    .version = "0.1.1",

    // Fingerprint is this package's permanent identity — it survives renames and
    // is how the package manager tells one package from another. It is NOT a
    // per-release value: do not regenerate it when tagging. Regenerate via
    // `zig init` only when forking into a genuinely different package.
    .fingerprint = 0x748fe196f69178d2,

    .minimum_zig_version = "0.16.0",

    .dependencies = .{},

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "bench",
        "examples",
        // Both licences ship: the four .md files below are documentation and are
        // CC BY 4.0, so a consumer receiving them without LICENSE-DOCS would hold
        // prose whose terms are not in the package.
        "LICENSE",
        "LICENSE-DOCS",
        "README.md",
        "SECURITY.md",
        "ARCHITECTURE.md",
        "CONTRIBUTING.md",
    },
}
